{
  "name": "jari",
  "version": "0.7.0",
  "description": "Simple keyboard-driven navigation extension for modern browsers.",
  "license": "MIT",
  "author": "Maulana Ahmad Aji Triadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bymaul/jari.git"
  },
  "homepage": "https://github.com/bymaul/jari",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test",
    "bench": "node benchmarks/rank.js",
    "build:chrome": "node build.ts chrome",
    "build:firefox": "node build.ts firefox",
    "dist": "node build.ts dist",
    "sign:firefox": "web-ext sign --source-dir=dist/jari-firefox --artifacts-dir=dist/signed --channel=unlisted"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "crx3": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "web-ext": "^10.7.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
