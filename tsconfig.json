{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node", "chrome"]
  },
  "include": [
    "shared/**/*",
    "content/**/*.ts",
    "background/**/*.ts",
    "popup/**/*.ts",
    "options/**/*.ts",
    "tests/**/*.ts"
  ]
}
