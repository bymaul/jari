{
  "manifest_version": 3,
  "name": "Jari",
  "version": "0.4.0",
  "description": "Simple keyboard-driven navigation extension for modern browsers.",
  "author": "Maulana Ahmad Aji Triadi",
  "homepage_url": "https://github.com/bymaul/jari",
  "browser_specific_settings": {
    "gecko": {
      "id": "jari@bymaul.github.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Jari /ja·ri/"
  },
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "clipboardRead",
    "history",
    "bookmarks",
    "search"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/bundle.js"],
      "css": ["content/content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
